# Hostinger Production Configuration
# This is your .env file for Hostinger deployment
# DO NOT commit this to Git
# Path: /home/username/public_html/numindstech/appsite/.env

# ============================================
# DATABASE CONFIGURATION (from Hostinger Panel)
# ============================================
# Get these from Hostinger → Databases → MySQL
DB_HOST=localhost
DB_NAME=u970188659_numinds
DB_USER=u970188659_admin
DB_PASS=YOUR_STRONG_PASSWORD_HERE

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# For folder structure: /numindstech/appsite/public
# If domain points directly to /public folder:
BASE_URL=https://yourdomain.com

# If domain points to numindstech/appsite and public is subfolder:
# BASE_URL=https://yourdomain.com/numindstech/appsite/public

# ============================================
# ENVIRONMENT
# ============================================
APP_ENV=production

# ============================================
# OPTIONAL: EMAIL CONFIGURATION (Hostinger)
# ============================================
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=587
# MAIL_USER=noreply@yourdomain.com
# MAIL_PASS=your_email_password
# MAIL_FROM=noreply@yourdomain.com
